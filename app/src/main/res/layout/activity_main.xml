<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TV address"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textColor="#2F7CF6"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:checked="true"
            android:text="Cast sound too"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Picture quality"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/q_med"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/q_low" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Smooth" />
            <RadioButton android:id="@+id/q_med" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Balanced" />
            <RadioButton android:id="@+id/q_high" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Sharp" />
        </RadioGroup>

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="Start casting"
            android:textSize="18sp" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="Stop casting"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Tips:\n• Works with any TV that has a web browser (smart TVs, Fire TV, Android/Google TV, game consoles), or a laptop plugged into the TV.\n• On the TV, press Start once so the browser allows sound.\n• Some apps (e.g. Netflix) block screen and sound capture; they will show black or be silent."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
